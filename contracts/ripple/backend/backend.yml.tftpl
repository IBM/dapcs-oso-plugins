${tpl.supervisord_configmaps}
---
apiVersion: v1
kind: Pod
metadata:
  name: backend-pod

spec:
  restartPolicy: Always

  containers:
    # Each bridge binds on its own internal port (9123, 9124, ...) and host port (9998, 9999, ...)
%{ for i, vault in tpl.vaults ~}
    - name: cold-bridge-${vault.num}
      image: ${tpl.cold_bridge_image}
      env:
        - name: Vault__Ids__0
          value: "${vault.vault_id}"
        # Passphrase: "{{EMPTY}}" is needed so that the bridge data is not cyphered and can be managed by OSO
        - name: Passphrase
          value: "{{EMPTY}}"
        - name: VAULT_COLD_PORT
          value: "${vault.bridge_port}"
      ports:
        - containerPort: ${vault.bridge_port}
          hostPort: ${vault.bridge_host_port}
%{ endfor ~}

    - name: kmsconnect
      image: ${tpl.kmsconnect_image}
      volumeMounts:
        - name: ibm-cfg
          mountPath: /opt/kms/cfg/ibm.cfg
        - name: ibm-cfg
          mountPath: /app/cfg/ibm.cfg
        - name: cert
          mountPath: /data/cert
          readOnly: true

    # KMS vault containers - one per vault
    # supervisord.conf is mounted from a ConfigMap per vault with unique -u <address>
    # so all vault instances can coexist in the shared pod network namespace
%{ for i, vault in tpl.vaults ~}
    - name: vault-${vault.num}
      image: ${tpl.cold_vault_image}
      command:
        - /bin/bash
        - -c
      args:
        - |
          until (echo > /dev/tcp/localhost/10000) 2>/dev/null; do
            sleep 2
          done
          exec /opt/entrypoint.sh
      env:
        - name: VAULT_CORE_ADDRESS
          value: "0.0.0.0:${vault.grpc_port}"
        - name: PLATFORM
          value: "${vault.platform}"
        - name: VAULT_BRIDGE_LOGLEVEL
          value: "7"
        - name: VAULT_CORE_LOGLEVEL
          value: "7"
        - name: VAULT_KMS_ENDPOINT
          value: "localhost:10000"
        - name: VAULT_TRUSTED_SIG
          value: "pem:${tpl.notary_messaging_public_key}"
        - name: VAULT_ID
          value: "${vault.vault_id}"
        - name: HARMONIZE_CORE_ENDPOINT
          value: "http://localhost:${vault.bridge_port}/internal/v1"
        - name: HMZ_FEATURE_OPTIONAL_MAXIMUM_FEE
          value: "true"
      volumeMounts:
        - name: vault-${vault.num}-supervisord-config
          mountPath: /opt/supervisord/supervisord.conf
          subPath: supervisord.conf
%{ endfor ~}

    - name: backend-plugin
      image: ${tpl.backend_plugin_image}
      envFrom:
        - configMapRef:
            name: contract.config.map
            optional: false
      env:
        - name: COMPONENT
          value: "backend_plugin"
        - name: OSOENCRYPTIONPASS
          value: "${tpl.seed}"
        # One endpoint per vault bridge - indexed for per-vault routing
%{ for i, vault in tpl.vaults ~}
        - name: COLD_BRIDGE_ENDPOINT__${i}
          value: "http://localhost:${vault.bridge_port}"
        - name: Vault__Ids__${i}
          value: "${vault.vault_id}"
%{ endfor ~}
        - name: PORT
          value: "4000"
      ports:
        - containerPort: 4000
          hostPort: 4000

%{ if tpl.enable_ep11server }
    - name: ep11server
      image: ${tpl.grep11_image}
      securityContext:
        runAsUser: 0
        privileged: true
      ports:
        - containerPort: 9876
          hostPort: 9876
      env:
        - name: PORT
          value: "9876"
      volumeMounts:
%{ if !tpl.crypto_pass_enable }
        - name: cfg
          mountPath: /etc/c16
%{ endif ~}
        - name: srv1
          mountPath: /cfg
        - name: grep11server-yaml
          mountPath: /etc/ep11server/ep11server.yaml
        - name: z90crypt
          mountPath: /dev/z90crypt
%{~ endif ~}

  volumes:

    - name: ibm-cfg
      hostPath:
        path: ./ibm.cfg
        type: File

    - name: cert
      hostPath:
        path: ./cert
        type: Directory

%{~ if tpl.enable_ep11server ~}
%{ if !tpl.crypto_pass_enable }
    - name: cfg
      hostPath:
        path: ./cfg
        type: Directory
%{ endif }

    - name: srv1
      hostPath:
        path: ./srv1
        type: Directory

    - name: grep11server-yaml
      hostPath:
        path: ./srv1/grep11server.yaml
        type: File

    - name: z90crypt
      hostPath:
        path: /dev/z90crypt
        type: CharDevice

%{~ endif ~}
%{ for i, vault in tpl.vaults ~}
    - name: vault-${vault.num}-supervisord-config
      configMap:
        name: vault-${vault.num}-supervisord-config
%{ endfor ~}

